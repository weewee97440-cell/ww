-- 📱 Aim point : center of screen on mobile, mouse pos on PC
local function GetAimPoint()
    if IsMobile then
        local vp = Camera.ViewportSize
        if vp.X > 0 and vp.Y > 0 then
            return Vector2.new(vp.X / 2, vp.Y / 2)
        end
    end
    return UserInputService:GetMouseLocation()
end

local function GetTarget()
    local mousePos = GetAimPoint()
    local camPos = Camera.CFrame.Position
    if Config.StickyAim and IsAiming() and State.LockedPlayer and IsAlive(State.LockedPlayer) then
        local head = GetHead(State.LockedPlayer.Character)
        if head then return State.LockedPlayer, head end
    end
    local rayOk, rayResult = pcall(function()
        local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
        return workspace:Raycast(ray.Origin, ray.Direction * 8000, params)
    end)
    if rayOk and rayResult and rayResult.Instance then
        local model = rayResult.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local hum = model:FindFirstChildOfClass("Humanoid")
            local head = model:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr and plr ~= LocalPlayer and not SameTeam(plr) then return plr, head end
            end
        end
    end
    local bestPlr, bestPart, bestScore = nil, nil, math.huge
    local baseFov = tonumber(Config.FOV) or 140
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and not SameTeam(plr) then
            local head = GetHead(plr.Character)
            if head then
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if sp.Z > 0 then
                    local worldDist = (head.Position - camPos).Magnitude
                    local screenDist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                    local dynFov = baseFov + math.clamp(worldDist * 0.35, 0, 220)
                    if screenDist <= dynFov and (onScreen or screenDist < dynFov * 0.85) then
                        local score = screenDist + worldDist * 0.002
                        if score < bestScore then bestScore = score; bestPlr = plr; bestPart = head end
                    end
                end
            end
        end
    end
    return bestPlr, bestPart
end

local function LockTarget(plr, part) State.LockedPlayer = plr; State.LockedPart = part end
local function UnlockTarget() State.LockedPlayer = nil; State.LockedPart = nil end

UserInputService.InputBegan:Connect(function(input, gp)
