local espAcc = 0
RunService.Heartbeat:Connect(function(dt)
    if not Config.ESPEnabled then return end
    for plr, data in pairs(ESPData) do
        if plr.Parent and data.hl then
            local off = data.hueOffset or 0
            if data.hl and data.hl.Parent then data.hl.FillColor = RainbowColor(off); data.hl.OutlineColor = RainbowColor(off+0.5) end
            if data.beam and data.beam.Parent then data.beam.Color = ColorSequence.new(RainbowColor(off+0.15)) end
            if data.nameLbl and data.nameLbl.Parent then data.nameLbl.TextColor3 = RainbowColor(off) end
            if data.weaponLbl and data.weaponLbl.Parent then data.weaponLbl.TextColor3 = RainbowColor(off+0.65) end
            if data.distLbl and data.distLbl.Parent then data.distLbl.TextColor3 = RainbowColor(off+0.15) end
            if data.coordsLbl and data.coordsLbl.Parent then data.coordsLbl.TextColor3 = RainbowColor(off+0.85) end
        end
    end
    espAcc = espAcc + (dt or 0.016)
    if espAcc < 0.2 then return end
    espAcc = 0
    local myRoot = GetRoot(LocalPlayer.Character)
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position
    if not myPos then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local d = ESPData[plr]
            if not d or not d.hl or not d.hl.Parent or d.char ~= plr.Character then pcall(CreateESP, plr) end
        end
    end
    for plr, data in pairs(ESPData) do
        if not plr.Parent then FullRemoveESP(plr)
        elseif plr.Character then
            local root = GetRoot(plr.Character) or plr.Character:FindFirstChild("Head")
            if root then
                if data.distLbl then
                    data.distLbl.Text = "📏 " .. math.floor((root.Position - myPos).Magnitude + 0.5) .. "m"
                end
