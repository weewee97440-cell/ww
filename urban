local function GetLockHead()
    if State.LockedPlayer and IsAlive(State.LockedPlayer) then
        local head = GetHead(State.LockedPlayer.Character)
        if head then State.LockedPart = head; return head end
    end
    local plr, part = GetTarget()
    if plr and part then
        local head = plr.Character and plr.Character:FindFirstChild("Head") or part
        LockTarget(plr, head); return head
    end
    return nil
end

local function CamLockStep()
    local mobileAimbot = IsMobile and Config.Aimbot
    if not (Config.CamLock or mobileAimbot) then return end
    if not IsAiming() then return end
    local plr = State.LockedPlayer
    local head = plr and IsAlive(plr) and plr.Character and plr.Character:FindFirstChild("Head")
    if not head then head = GetLockHead() end
    if not head or not head.Parent then return end
    State.LockedPart = head; if plr then State.LockedPlayer = plr end
    local cam = workspace.CurrentCamera; if not cam then return end
    local camPos = cam.CFrame.Position
    if (head.Position - camPos).Magnitude < 0.15 then return end
    cam.CFrame = CFrame.lookAt(camPos, head.Position, Vector3.yAxis)
end

local function AimbotStep()
    if not Config.Aimbot then return end
    if IsMobile then return end -- mobile uses CamLockStep (mousemoverel unavailable)
    if not (State.HoldLMB or State.HoldRMB) or Config.CamLock then return end
    local head = GetLockHead(); if not head or not head.Parent then return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
    if not onScreen or screenPos.Z <= 0 then return end
    local mousePos = UserInputService:GetMouseLocation()
    local smooth = math.clamp(tonumber(Config.Smooth) or 0.15, 0.02, 0.9)
    local strength = (1 - smooth) * 0.9
    local dx = (screenPos.X - mousePos.X) * strength
    local dy = (screenPos.Y - mousePos.Y) * strength
    if math.abs(dx) < 0.35 and math.abs(dy) < 0.35 then return end
    if type(mousemoverel) == "function" then pcall(mousemoverel, dx, dy) end
end

