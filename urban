local ESPData = {}
local function DestroyESP(plr)
    local d = ESPData[plr]; if not d then return end
    pcall(function() if d.hl then d.hl:Destroy() end end)
    pcall(function() if d.bb then d.bb:Destroy() end end)
    pcall(function() if d.attach0 then d.attach0:Destroy() end end)
    pcall(function() if d.attach1 then d.attach1:Destroy() end end)
    pcall(function() if d.beam then d.beam:Destroy() end end)
    ESPData[plr] = { hooked = d.hooked }
end
local function FullRemoveESP(plr)
    local d = ESPData[plr]
    if d then
        pcall(function() if d.hl then d.hl:Destroy() end end)
        pcall(function() if d.bb then d.bb:Destroy() end end)
        pcall(function() if d.attach0 then d.attach0:Destroy() end end)
        pcall(function() if d.attach1 then d.attach1:Destroy() end end)
        pcall(function() if d.beam then d.beam:Destroy() end end)
    end
    ESPData[plr] = nil
end
local function GetOrCreateLocalAttach()
