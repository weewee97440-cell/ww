local savePending = false
local function SaveConfigNow()
    pcall(function()
        if writefile then
            writefile(CONFIG_FILE, HttpService:JSONEncode(_config))
        end
    end)
end
local function SaveConfigDebounced()
    if savePending then return end
    savePending = true
    task.delay(0.8, function()
        SaveConfigNow(); savePending = false
    end)
end

local Config = setmetatable({}, {
    __index = function(_, k) return _config[k] end,
    __newindex = function(_, k, v) _config[k] = v; SaveConfigDebounced() end,
})

local function LoadConfigFile()
    pcall(function()
        if isfile and isfile(CONFIG_FILE) and readfile then
            local data = readfile(CONFIG_FILE)
            if data and #data > 0 then
                local decoded = HttpService:JSONDecode(data)
                for k, v in pairs(decoded) do
                    if _config[k] ~= nil then _config[k] = v end
                end
            end
        end
    end)
end

local function ResetConfigToDefaults()
    for k, v in pairs(DEFAULT_CONFIG) do _config[k] = v end
