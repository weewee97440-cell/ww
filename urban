local function HookPlayerESP(plr)
    if not plr or plr == LocalPlayer then return end
    if not ESPData[plr] then ESPData[plr] = {} end
    if ESPData[plr].hooked then
        if Config.ESPEnabled and plr.Character then pcall(CreateESP, plr) end
        return
    end
    ESPData[plr].hooked = true
    pcall(function()
        plr.CharacterAdded:Connect(function()
            if not Config.ESPEnabled then return end
            task.wait(0.25); pcall(CreateESP, plr)
            task.delay(0.75, function() if Config.ESPEnabled then pcall(CreateESP, plr) end end)
        end)
    end)
    if Config.ESPEnabled and plr.Character then pcall(CreateESP, plr) end
end
local function RefreshAllESP()
    if not Config.ESPEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            HookPlayerESP(plr)
            if plr.Character then pcall(CreateESP, plr) end
        end
    end
end
local function ToggleESP(state)
    Config.ESPEnabled = state and true or false
    if not Config.ESPEnabled then
        for plr in pairs(ESPData) do DestroyESP(plr) end
        return
    end
    RefreshAllESP()
end

