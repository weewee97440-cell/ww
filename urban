-- VEHICLE
local function FindNearestVehicle(maxDist)
    maxDist = maxDist or 80
    local root = GetRoot(LocalPlayer.Character); if not root then return nil end
    local best, bestD = nil, maxDist
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") then
            local model = obj:FindFirstAncestorOfClass("Model")
            if model then
                local d = (obj.Position - root.Position).Magnitude
                if d < bestD then bestD = d; best = model end
            end
        end
    end
    return best
end
local function GetVehicleSeat(m) return m and m:FindFirstChildWhichIsA("VehicleSeat", true) end
local function GetVehiclePart(m)
    if not m then return nil end
    if m.PrimaryPart then return m.PrimaryPart end
    return GetVehicleSeat(m) or m:FindFirstChildWhichIsA("BasePart", true)
end
local function ClearCarFlyForces()
    if State.CarBV then pcall(function() State.CarBV:Destroy() end) State.CarBV = nil end
    if State.CarBG then pcall(function() State.CarBG:Destroy() end) State.CarBG = nil end
end
local function EnterNearestCar()
    local char = LocalPlayer.Character; local hum = GetHum(char); local root = GetRoot(char)
    if not hum or not root then return false end
    if hum.SeatPart then
        local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if model then State.CarModel = model; return true end
    end
    local car = FindNearestVehicle(120)
    if not car then warn("[71 VS] Aucune voiture proche"); return false end
    local seat = GetVehicleSeat(car)
    if not seat then return false end
    pcall(function() car:PivotTo(root.CFrame * CFrame.new(0, 1, -8)) end)
    task.wait(0.1)
    pcall(function() seat:Sit(hum) end)
    State.CarModel = car
    return true
end
local function StartCarFly()
    ClearCarFlyForces(); EnterNearestCar()
    local part = GetVehiclePart(State.CarModel)
    if not part then warn("[71 VS] Car Fly: pas de vehicule"); Config.CarFly = false; return end
    pcall(function() if part.SetNetworkOwner then part:SetNetworkOwner(LocalPlayer) end end)
    State.CarBV = Instance.new("BodyVelocity")
    State.CarBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    State.CarBV.Velocity = Vector3.zero; State.CarBV.Parent = part
    State.CarBG = Instance.new("BodyGyro")
    State.CarBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    State.CarBG.P = 3000; State.CarBG.D = 500
    State.CarBG.CFrame = part.CFrame; State.CarBG.Parent = part
end
local function StopCarFly() ClearCarFlyForces(); State.CarModel = nil end

RunService.Heartbeat:Connect(function()
    if not Config.CarFly then
        if State.CarBV or State.CarBG then StopCarFly() end
        return
    end
    if not State.CarBV or not State.CarBV.Parent then StartCarFly(); if not State.CarBV then return end end
    local part = State.CarBV.Parent
    if not part or not part.Parent then StartCarFly(); return end
    local cam = workspace.CurrentCamera; if not cam then return end
    local move = Vector3.zero
    local function down(k) return UserInputService:IsKeyDown(k) end
    if down(Enum.KeyCode.Z) or down(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
    if down(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
    if down(Enum.KeyCode.Q) or down(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
    if down(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
    local vel = Vector3.zero
    if move.Magnitude > 0.1 then vel = move.Unit * Config.CarFlySpeed end
    if down(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, Config.CarFlyUpSpeed, 0) end
    if down(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, Config.CarFlyUpSpeed, 0) end
    State.CarBV.Velocity = vel
    if State.CarBG and State.CarBG.Parent then
        local flat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
        if flat.Magnitude > 0.1 then
            State.CarBG.CFrame = CFrame.lookAt(part.Position, part.Position + flat.Unit)
        end
    end
end)

