local function CreateSlider(parent, text, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 68)
    frame.BackgroundColor3 = Theme.Card
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0; frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
    local st = Instance.new("UIStroke", frame)
    st.Color = Theme.Border; st.Thickness = 1.5; st.Transparency = 0.4

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -84, 0, 20)
    lbl.Position = UDim2.new(0, 16, 0, 8)
    lbl.BackgroundTransparency = 1; lbl.Text = text
    lbl.TextColor3 = Theme.Text
    SetFont(lbl, "Body"); lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 64, 0, 26)
    valLbl.Position = UDim2.new(1, -80, 0, 6)
    valLbl.BackgroundColor3 = Theme.Bg2
    valLbl.BackgroundTransparency = 0.15
    valLbl.BorderSizePixel = 0; valLbl.Text = tostring(default)
    valLbl.TextColor3 = Theme.AccentSoft
    SetFont(valLbl, "Mono"); valLbl.TextSize = 13
    valLbl.Parent = frame
    Instance.new("UICorner", valLbl).CornerRadius = UDim.new(0, 8)

    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(1, -32, 0, 32)
    hit.Position = UDim2.new(0, 16, 0, 32)
    hit.BackgroundTransparency = 1; hit.Text = ""; hit.AutoButtonColor = false
    hit.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 8)
    bar.Position = UDim2.new(0, 0, 0.5, -4)
    bar.BackgroundColor3 = Theme.TrackOff
    bar.BorderSizePixel = 0; bar.Parent = hit
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    local rel0 = (default - min) / math.max(max - min, 1)
    fill.Size = UDim2.new(rel0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0; fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fillGrad = Instance.new("UIGradient")
    fillGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Theme.Accent2),
        ColorSequenceKeypoint.new(1, Theme.AccentSoft),
    }
    fillGrad.Parent = fill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(rel0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0; knob.Parent = hit
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local kSt = Instance.new("UIStroke", knob)
    kSt.Color = Theme.Accent; kSt.Thickness = 2.5

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
        local val = math.floor(min + (max - min) * rel + 0.5)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(val)
        callback(val)
    end
    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(input.Position.X)
            TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                Size = UDim2.new(0, 26, 0, 26)
            }):Play()
        end
    end
    hit.InputBegan:Connect(beginDrag)
    knob.InputBegan:Connect(beginDrag)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
                Size = UDim2.new(0, 22, 0, 22)
            }):Play()
        end
    end)
    frame.MouseEnter:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.15), { BackgroundColor3 = Theme.CardHover, BackgroundTransparency = 0.1 }):Play()
        TweenService:Create(st, TweenInfo.new(0.15), { Transparency = 0.2 }):Play()
    end)
    frame.MouseLeave:Connect(function()
        if not dragging then
            TweenService:Create(frame, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Card, BackgroundTransparency = 0.25 }):Play()
            TweenService:Create(st, TweenInfo.new(0.15), { Transparency = 0.4 }):Play()
        end
    end)

    return { set = function(v)
        local rel = (v - min) / math.max(max - min, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(v)
    end }
end

