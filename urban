-- WEAPON
local RECOIL_KEYS = { "recoil", "kick", "shake", "camera", "bloom", "spread", "inaccuracy", "sway" }
local DELAY_KEYS = { "delay", "cooldown", "firerate", "fire rate", "rpm", "bolt", "reload", "equip", "debounce", "interval", "cycle" }
local function WeaponNameMatch(name, keys)
    name = string.lower(name or "")
    for i = 1, #keys do if string.find(name, keys[i], 1, true) then return true end end
    return false
end
local function ApplyWeaponMods(tool)
    if not tool or not tool:IsA("Tool") then return end
    if not (Config.NoRecoil or Config.NoDelay) then return end
    local n = 0
    for _, v in ipairs(tool:GetDescendants()) do
        n = n + 1; if n > 120 then break end
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            if Config.NoRecoil and WeaponNameMatch(v.Name, RECOIL_KEYS) then pcall(function() v.Value = 0 end) end
            if Config.NoDelay and WeaponNameMatch(v.Name, DELAY_KEYS) then
                local low = string.lower(v.Name)
                if string.find(low, "reload", 1, true) then pcall(function() v.Value = math.min(v.Value, 0.05) end)
                else pcall(function() v.Value = 0.01 end) end
            end
        elseif v:IsA("BoolValue") and Config.NoDelay then
            local low = string.lower(v.Name)
            if string.find(low, "delay", 1, true) or string.find(low, "cooldown", 1, true) then pcall(function() v.Value = false end) end
        end
    end
end
local function HookCharacterWeapons(char)
    if not char then return end
    for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then ApplyWeaponMods(c) end end
    char.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.1); ApplyWeaponMods(c) end end)
end
if LocalPlayer.Character then HookCharacterWeapons(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char) task.wait(0.2); HookCharacterWeapons(char) end)
task.spawn(function()
    while true do
        task.wait(0.75)
        if Config.NoRecoil or Config.NoDelay then
            local char = LocalPlayer.Character
            if char then local t = char:FindFirstChildOfClass("Tool"); if t then pcall(ApplyWeaponMods, t) end end
        end
    end
end)

